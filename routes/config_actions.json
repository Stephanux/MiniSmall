    "GET/tabFormations": {
        "controler": "sql/selectSQL",
        "sql_query": "SELECT id_formation, libelle, duree, plan_cours, prix, fk_formateur FROM formations INNER JOIN formateurs ON formations.fk_formateur = formateurs.id_formateur",
        "view": "tab_generic",
        "tab_columns": {
            "N°Formation": "id_formation",
            "libelle": "libelle",
            "durée": "duree",
            "Plan de cours": "plan_cours",
            "Prix": "prix",
            "N° formateur": "fk_formateur",
            "Nom formateur": "nom",
            "Prénom formateur": "prenom",
            "Spécialité": "specialite",
            "Prix Jour": "prix_jour"
        },
        "title": "Liste des formations"
    },
    "GET/formFormation": {
       "controler": "sql/selectByIdAndListSchemas",
