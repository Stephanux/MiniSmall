    "POST/createFormation": {
        "controler": "sql/insertSQL",
        "sql_query": "INSERT INTO formations (libelle, duree, plan_cours, prix, id_formateur) VALUES( ?,?,?,?,?)",
        "params_query": [
            "libelle", 
            "duree", 
            "plan_cours", 
            "prix",
            "id_formateur"
        ],
        "redirect": "/formations"
    },
    "POST/modifyFormation": {
        "controler": "sql/updateSQL",
        "sql_query": "UPDATE formations SET libelle=?, duree=?, plan_cours=?, prix=?, id_formateur=?",
        "params_query": [
           "libelle", 
            "duree", 
            "plan_cours", 
            "prix",
            "id_formateur"
        ],
        "redirect": "/formations"
    },
    "GET/deleteFormation": {
        "controler": "sql/deleteSQLById",
