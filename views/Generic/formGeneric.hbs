<div class="center" style="padding-top: 4px;padding-bottom: 4px;">
    <h1> Express App : {{title}}</h1>
    <div class="container">
        <form method="POST" action="{{form_action}}" id="formAdd">
            {{#each data}}
      
            {{!-- trouver le moyen de tester si clé externe pour afficher une lite déroulante--}}
                {{#compare @key ../fkey operator="!="}}
                      <div class="inputbox">
                        {{#compare ../type_form "create" operator="==="}}
                            <input type="text" name="{{@key}}" id="{{@key}}" value="" class="form-control" />
                        {{else}}
                            <input type="text" name="{{@key}}" id="{{@key}}" value="{{.}}" class="form-control" />
                        {{/compare}}
                        <span>{{@key}}</span>
                    </div><br>
                {{else}}   
                    <div class="inputbox">
                    <select name="{{../fkey}}" id="{{../fkey}}">
                    {{!-- trouver comment remplacer 'formateurs' par un truc generic --}}
                    {{#each ../datas}}  
                        {{#each this}}  {{!-- C'est un array contenant un objet à ce niveau --}}
                            {{!-- trouver comment remplacerles nom des champs ci-dessous --}}
                            <option value="{{this.idfk}}">{{#each .}} {{this}}-{{/each}}</option>
                        {{/each}}
                    {{/each}}
                    </select>
                    <span>{{@key}}</span> 
                </div>
                {{/compare}}
            {{/each}}
            <table class="center">
                <tr>
                    <td>
                        <div class="inputbox">
                            <button>Confirmer la {{libelle}}</button>
                        </div>
                    </td>
                    <td>
                        <div class="inputbox">
                            <button value="" type="button" id="delbtn" class="button">Supprimer {{del_label}}</button>
                        </div>
                    </td>
                </tr>
            </table>
        </form>
    </div>
</div>
{{!-- Script de validation du formulaire de modification --}}
<script>
    //var list_formateurs = {{liste}};
    var form = document.getElementById('formAdd');
    var id="{{label_id}}";
    form.addEventListener('submit', function (evt) {
        var actionPost = "/" + form.action.split('/')[3];
        if (actionPost == "{{form_action}}") form.action += "/"+document.URL.split('/')[4];
        form.submit();
    });
    var btn_del = document.getElementById('delbtn');
    btn_del.addEventListener('click', function (evt) {
        window.location = "/deleteFormation/"+document.URL.split('/')[4];
    });
</script>