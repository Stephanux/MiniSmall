<fieldset>
  {{#each datas}}  
   <legend>Choisir vôtre {{@key}} :</legend>
    {{#each this}}  {{!-- C'est un array contenant des objets à ce niveau --}}
      {{!-- utilisation de each sur les objets (ici .) contenu dans le tableau --}}
        <div>
          {{#compare ../../data.fkid this.idfk operator='=='}} 
            <input type="checkbox" value="{{this.idfk}}" id="{{this.idfk}}" name="{{../../fkey}}" checked=""/>
          {{else}}
            <input type="checkbox" value="{{this.idfk}}" id="{{this.idfk}}" name="{{../../fkey}}" />
          {{/compare}}
          <label for="scales">{{#each .}} {{.}}-{{/each}}</label>
        </div>  
    {{/each}}
  {{/each}}
</fieldset>

